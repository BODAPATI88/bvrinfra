---
import Base from "../layouts/Base.astro";

const email = "hello@bvrinfra.in";
const phoneDisplay = "+91 95992 29585";
const phoneTel = "+919599229585";
const whatsapp = "https://wa.me/919599229585";
const linkedin = "https://www.linkedin.com/in/ravikishore-b-917b85226/";

// Generic drawn icons, not brand logos.
const icons = {
  email: '<path d="M3.5 6.5h17v11h-17z"/><path d="m3.5 7 8.5 6.5L20.5 7"/>',
  chat: '<path d="M4 5.5h16v10H9.5L5.5 19v-3.5H4z"/><path d="M8 9.5h8M8 12.5h5"/>',
  phone: '<path d="M7.2 3.8 9.7 4.4l1 4.1-2 1.4a12 12 0 0 0 5.4 5.4l1.4-2 4.1 1-.1 2.6c-.1 1.2-1.1 2.1-2.3 2A16.5 16.5 0 0 1 3.6 7c-.1-1.2.8-2.2 2-2.3z"/>',
  profile: '<rect x="3.5" y="5" width="17" height="14" rx="2"/><circle cx="9" cy="11" r="2.2"/><path d="M5.8 16.2c.6-1.6 1.8-2.4 3.2-2.4s2.6.8 3.2 2.4M14.5 10h3.5M14.5 13h3.5"/>',
  code: '<path d="m8.5 7-5 5 5 5M15.5 7l5 5-5 5M13.5 5l-3 14"/>',
};

const channels = [
  { label: "Email", icon: icons.email, href: `mailto:${email}`, primary: true },
  { label: "WhatsApp", icon: icons.chat, href: whatsapp },
  { label: "Call", icon: icons.phone, href: `tel:${phoneTel}` },
  { label: "LinkedIn", icon: icons.profile, href: linkedin },
  { label: "GitHub", icon: icons.code, href: "https://github.com/BODAPATI88" },
];

const reasons = [
  {
    title: "Infrastructure and platform roles",
    body: "Windows Server and Active Directory, VMware, hybrid Azure and data-centre operations, moving towards platform engineering and SRE.",
  },
  {
    title: "Freelance infrastructure work",
    body: "Active Directory, vSphere, Azure and Microsoft 365, scoped as a defined piece of work.",
  },
  {
    title: "My CV and full work history",
    body: "Every role, employer and date. Ask by email and I'll send it.",
  },
];
---
<Base
  title="Contact, Ravi Kishore"
  description="How to reach Ravi Kishore: email, WhatsApp, phone and LinkedIn. Hyderabad, India (IST, UTC+5:30)."
>
  <h1 class="page-title">Contact</h1>
  <p class="lede">
    Open to infrastructure and platform engineering roles, and to freelance infrastructure work.
    Email or WhatsApp is the most reliable way to reach me.
  </p>

  <ul class="channels" aria-label="Ways to reach me">
    {channels.map((c) => (
      <li>
        <a href={c.href} class:list={["chan", c.primary && "primary"]}>
          <span class="disc" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={c.icon} />
          </span>
          <span class="chan-label">{c.label}</span>
        </a>
      </li>
    ))}
  </ul>

  <p class="plain">
    <span>{email}</span>
    <span>{phoneDisplay}</span>
  </p>

  <section class="block" aria-labelledby="where">
    <h2 id="where">Where and when</h2>
    <dl class="where">
      <div><dt>Based in</dt><dd>Hyderabad, India</dd></div>
      <div><dt>Time zone</dt><dd>IST, UTC+5:30</dd></div>
      <div><dt>Availability</dt><dd>I work rotational shifts, so I may not answer a call straight away. A message always reaches me.</dd></div>
    </dl>
  </section>

  <section class="block" aria-labelledby="about">
    <h2 id="about">Good reasons to get in touch</h2>
    <ul class="reasons">
      {reasons.map((r) => (
        <li>
          <h3>{r.title}</h3>
          <p>{r.body}</p>
        </li>
      ))}
    </ul>
  </section>
</Base>

<style>
  .channels {
    list-style: none; margin: clamp(2rem, 5vw, 3rem) 0 0; padding: 0;
    display: flex; flex-wrap: wrap; gap: clamp(0.75rem, 3vw, 1.75rem);
  }
  .chan {
    display: flex; flex-direction: column; align-items: center; gap: 0.5rem;
    min-width: 4.5rem;
    color: var(--ink); text-decoration: none;
  }
  .disc {
    display: grid; place-items: center;
    width: 4rem; height: 4rem; border-radius: 50%;
    background: var(--panel); border: 1px solid var(--rule);
  }
  .chan:hover .disc { border-color: var(--ink); transform: translateY(-2px); }
  .chan:focus-visible { outline: none; }
  .chan:focus-visible .disc { outline: 3px solid var(--cable); outline-offset: 3px; }
  .chan-label { font-size: 0.9rem; font-stretch: 88%; }
  .primary .disc { background: var(--led-live); border-color: var(--led-live); color: #06210f; }
  .primary .chan-label { font-weight: 700; }

  .plain {
    margin: 1.5rem 0 0;
    display: flex; flex-wrap: wrap; gap: 0.25rem 1.5rem;
    color: var(--muted); font-size: 0.95rem;
  }

  .block { margin-top: clamp(2.5rem, 6vw, 3.5rem); max-width: 46rem; }
  .block h2 {
    font-size: clamp(1.35rem, 1.1rem + 0.8vw, 1.8rem);
    font-stretch: 90%;
    margin-bottom: 1rem;
  }
  .where { margin: 0; }
  .where div {
    display: grid; grid-template-columns: 9rem minmax(0, 1fr); gap: 1.25rem;
    padding-block: 0.85rem; border-top: 1px solid var(--rule);
  }
  .where div:last-child { border-bottom: 1px solid var(--rule); }
  .where dt { color: var(--muted); font-stretch: 85%; }
  .where dd { margin: 0; }

  .reasons { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.1rem; }
  .reasons li { padding-left: 1rem; border-left: 3px solid var(--led-live); }
  .reasons h3 { font-size: 1.1rem; font-stretch: 92%; }
  .reasons p { margin: 0.3rem 0 0; color: var(--muted); max-width: 38em; }

  @media (forced-colors: active) {
    .disc { border: 1px solid CanvasText; }
    .primary .disc { forced-color-adjust: none; }
  }
  @media (max-width: 30rem) {
    .channels { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 0.25rem; }
    .chan { min-width: 0; }
    .disc { width: 3.1rem; height: 3.1rem; }
    .disc svg { width: 22px; height: 22px; }
    .chan-label { font-size: 0.78rem; }
  }
  @media (max-width: 40rem) {
    .where div { grid-template-columns: 1fr; gap: 0.2rem; }
  }
</style>
