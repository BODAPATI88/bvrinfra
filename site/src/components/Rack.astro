---
import { stack, statusLabel } from "../data/stack";
// Racks are numbered from the bottom, so U1 renders last.
const units = stack.map((u, i) => ({ ...u, u: i + 1 })).reverse();
const live = stack.filter((u) => u.status === "live").length;
---
<figure class="rack">
  <figcaption>
    <span class="rack-name">This site, as built</span>
    <span class="rack-count">{live} of {stack.length} units live</span>
  </figcaption>
  <ol class="units" reversed>
    {units.map((unit) => (
      <li class:list={["unit", unit.status]}>
        <span class="u">U{unit.u}</span>
        <span class="body">
          <span class="name">{unit.name}</span>
          <span class="detail">{unit.detail}</span>
        </span>
        <span class="state">
          <span class="led" aria-hidden="true"></span>
          {statusLabel[unit.status]}
        </span>
      </li>
    ))}
  </ol>
</figure>

<style>
  .rack {
    margin: 0;
    background: var(--steel);
    color: #dfe5ea;
    border-radius: 6px;
    padding: 0.9rem 1.1rem 1.1rem;
    box-shadow: inset 0 0 0 1px var(--steel-line);
  }
  figcaption {
    display: flex; justify-content: space-between; align-items: baseline; gap: 1rem;
    padding: 0.1rem 0.15rem 0.8rem;
    font-variation-settings: "wdth" 75;
  }
  .rack-name { font-weight: 650; }
  .rack-count { color: #a9b4be; font-size: 0.9rem; }

  .units {
    list-style: none; margin: 0; padding: 0;
    border-inline: 6px solid #3b4550;
    background: repeating-linear-gradient(to bottom, #1d242b 0 1px, transparent 1px 100%);
  }
  .unit {
    display: grid;
    grid-template-columns: 2.6rem 1fr auto;
    align-items: center;
    gap: 0.9rem;
    padding: 0.75rem 0.85rem;
    background: #333d47;
    border-bottom: 2px solid #1d242b;
  }
  .unit:last-child { border-bottom: 0; }
  .u {
    font-variation-settings: "wdth" 62;
    font-weight: 600; font-size: 0.85rem; color: #93a0ab;
    font-variant-numeric: tabular-nums;
  }
  .body { display: flex; flex-direction: column; min-width: 0; }
  .name { font-weight: 650; font-variation-settings: "wdth" 85; font-size: 1.05rem; }
  .detail { color: #a9b4be; font-size: 0.88rem; }
  .state {
    display: inline-flex; align-items: center; gap: 0.5rem;
    font-size: 0.85rem; font-variation-settings: "wdth" 75; color: #c9d1d8;
    white-space: nowrap;
  }
  .led {
    width: 0.6rem; height: 0.6rem; border-radius: 50%;
    background: var(--led-off);
    box-shadow: inset 0 0 0 1px rgba(0,0,0,0.35);
  }
  .live .led { background: var(--led-live); box-shadow: 0 0 0 3px rgba(47,179,107,0.18); }
  .building .led { background: var(--led-build); box-shadow: 0 0 0 3px rgba(224,165,38,0.16); }
  .planned { background: #2d363f; }
  .planned .name { color: #b9c3cb; }

  @media (prefers-reduced-motion: no-preference) {
    .building .led { animation: blink 1.6s steps(2, jump-none) infinite; }
    @keyframes blink { 50% { opacity: 0.35; } }
  }
  @media (max-width: 22rem) {
    .unit { grid-template-columns: 2.1rem 1fr; }
    .state { grid-column: 2; }
  }
</style>
