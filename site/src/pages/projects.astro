---
import Base from "../layouts/Base.astro";

const projects = [
  {
    name: "bvrinfra",
    href: "https://github.com/BODAPATI88/bvrinfra",
    state: "Active",
    summary: "This site and the infrastructure behind it: static Astro on Cloudflare Pages, a protected main branch, DNS managed in Terraform with manual apply, and decision records for every architectural choice.",
  },
  {
    name: "infra-homelab",
    state: "Private while being hardened",
    summary: "My Proxmox homelab: manifests, ops scripts, namespace quotas and runbooks from a K3s, ArgoCD and Prometheus setup I ran there until September 2026. Services run on Docker Compose today. Next: admin access behind Cloudflare Access, off-site backups with a tested restore, and the homelab described as code.",
  },
  {
    name: "bvrinfra-site",
    href: "https://github.com/BODAPATI88/bvrinfra-site",
    state: "Archived",
    summary: "The previous version of this site, built as a Kubernetes stack behind a Cloudflare Tunnel. Kept as a record of what it got right, like its locked-down metrics API, and what it got wrong. The post-mortem covers how it was lost.",
  },
];
---
<Base
  title="Projects, Ravi Kishore"
  description="Infrastructure projects by Ravi Kishore: this site as code, a K3s homelab, and the archived previous site."
>
  <h1 class="page-title">Projects</h1>
  <p class="lede">What I'm building, with an honest status for each. The <a href="/writing/september-2026-outage/">September 2026 post-mortem</a> explains why the rebuild looks the way it does.</p>

  <ul class="projects">
    {projects.map((p) => (
      <li>
        <div class="head">
          <h2>{p.href ? <a href={p.href}>{p.name}</a> : p.name}</h2>
          <span class="state">{p.state}</span>
        </div>
        <p>{p.summary}</p>
      </li>
    ))}
  </ul>
</Base>

<style>
  .projects { list-style: none; margin: 2.5rem 0 0; padding: 0; max-width: 46rem; }
  .projects li { padding-block: 1.5rem; border-top: 1px solid var(--rule); }
  .projects li:last-child { border-bottom: 1px solid var(--rule); }
  .head { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; flex-wrap: wrap; margin-bottom: 0.5rem; }
  .head h2 { font-size: 1.4rem; font-variation-settings: "wdth" 90; }
  .head h2 a { color: var(--ink); text-decoration: none; }
  .head h2 a:hover { color: var(--cable); text-decoration: underline; }
  .state { color: var(--muted); font-variation-settings: "wdth" 75; font-size: 0.95rem; }
  .projects p { margin: 0; max-width: 38em; }
</style>
