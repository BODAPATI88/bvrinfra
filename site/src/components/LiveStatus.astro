---
// Live telemetry panel: visual gauges, rings and agent status loaded from homelab API.
// At build time we show static baseline from Upptime. Browser JS replaces with live values.
import { execSync } from "node:child_process";
import { dnsRecordCount } from "../data/dns";

const SUMMARY = "https://raw.githubusercontent.com/BODAPATI88/status/master/history/summary.json";

interface Site { slug: string; status: string; uptime: string; time: number }
let sites: Site[] = [];
try {
  const res = await fetch(SUMMARY, { signal: AbortSignal.timeout(5000) });
  if (res.ok) sites = await res.json();
} catch {}
const apex = sites.find((s) => s.slug === "bvrinfra-in");
const upCount = sites.filter((s) => s.status === "up").length;
const statusState = sites.length ? (upCount === sites.length ? "up" : "down") : "unknown";

let sha = process.env.CF_PAGES_COMMIT_SHA ?? process.env.SITE_COMMIT_SHA ?? "";
if (!sha) {
  try { sha = execSync("git rev-parse HEAD", { stdio: ["ignore", "pipe", "ignore"] }).toString().trim(); } catch {}
}
const deployed = new Date().toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric", timeZone: "Asia/Kolkata" });
---

<section class="live" aria-labelledby="live-h" data-live-root data-src={SUMMARY}>
  <div class="live-head">
    <div>
      <h2 id="live-h">Live System Telemetry</h2>
      <p class="live-tagline">Real-time silicon metrics — updated every 30 seconds from my private homelab.</p>
    </div>
    <div class="live-links">
      <span class="live-badge" data-live="origin-badge">
        <span class="badge-dot" data-live="badge-dot" data-state={statusState}></span>
        <span data-live="origin-label">Homelab Online</span>
      </span>
      <a class="live-src" href="https://status.bvrinfra.in" target="_blank" rel="noopener">Audit &rarr;</a>
    </div>
  </div>

  <!-- ROW 1: Gauges -->
  <div class="gauges-row" role="group" aria-label="Resource utilisation">

    <!-- CPU Ring Gauge -->
    <div class="gauge-card">
      <div class="ring-wrap" aria-label="CPU utilisation">
        <svg class="ring" viewBox="0 0 100 100" width="100" height="100" aria-hidden="true">
          <circle class="ring-bg" cx="50" cy="50" r="40" />
          <circle class="ring-fill ring-cpu" cx="50" cy="50" r="40"
            stroke-dasharray="251.2"
            stroke-dashoffset="251.2"
            data-live="cpu-ring" />
        </svg>
        <div class="ring-label">
          <span class="ring-val" data-live="cpu-val">—</span>
          <span class="ring-unit">CPU</span>
        </div>
      </div>
      <p class="gauge-name">CPU Load <span class="gauge-hint">(1 min avg)</span></p>
      <div class="sparkbar-wrap" aria-label="CPU trend">
        <div class="sparkbar" id="cpu-spark"></div>
      </div>
    </div>

    <!-- RAM Ring Gauge -->
    <div class="gauge-card">
      <div class="ring-wrap" aria-label="RAM utilisation">
        <svg class="ring" viewBox="0 0 100 100" width="100" height="100" aria-hidden="true">
          <circle class="ring-bg" cx="50" cy="50" r="40" />
          <circle class="ring-fill ring-ram" cx="50" cy="50" r="40"
            stroke-dasharray="251.2"
            stroke-dashoffset="251.2"
            data-live="ram-ring" />
        </svg>
        <div class="ring-label">
          <span class="ring-val" data-live="ram-val">—</span>
          <span class="ring-unit">RAM</span>
        </div>
      </div>
      <p class="gauge-name">Memory Used <span class="gauge-hint" data-live="ram-gb">of 15.4 GB</span></p>
      <div class="bar-row">
        <div class="bar-track"><div class="bar-fill bar-green" data-live="ram-bar" style="width:0%"></div></div>
        <span class="bar-label" data-live="ram-pct-label">—%</span>
      </div>
    </div>

    <!-- Uptime Card -->
    <div class="gauge-card gauge-card--uptime">
      <div class="uptime-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="36" height="36" fill="none" stroke="currentColor" stroke-width="1.6">
          <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
        </svg>
      </div>
      <div class="uptime-data">
        <span class="uptime-val" data-live="uptime-val">—</span>
        <span class="uptime-unit">hours uptime</span>
      </div>
      <p class="gauge-name">Node Online Since Boot</p>
      <p class="gauge-hint" data-live="site-uptime">Site: 100% · 30 days</p>
    </div>

    <!-- Response Speed -->
    <div class="gauge-card gauge-card--speed">
      <div class="speed-wrap">
        <span class="speed-val" data-live="time">{apex ? apex.time : "—"}</span>
        <span class="speed-unit">ms</span>
      </div>
      <p class="gauge-name">Global Response</p>
      <p class="gauge-hint">Cloudflare edge, worldwide</p>
      <div class="bar-row">
        <div class="bar-track">
          <div class="bar-fill bar-teal" data-live="speed-bar" style="width:80%"></div>
        </div>
        <span class="bar-label bar-label--good">Fast</span>
      </div>
    </div>

  </div>

  <!-- ROW 2: Container health + AI Agents -->
  <div class="bottom-row">

    <!-- Container Health -->
    <div class="container-panel">
      <h3 class="panel-title">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/></svg>
        Container Services
        <span class="panel-badge" data-live="container-count">— running</span>
      </h3>
      <ul class="container-list" data-live="container-list">
        <!-- filled by JS; static fallback below -->
        <li class="ctr-row">
          <span class="ctr-dot ctr-dot--up"></span>
          <span class="ctr-name">bvr-api</span>
          <span class="ctr-role">FastAPI · port 8000</span>
          <span class="ctr-state">running</span>
        </li>
        <li class="ctr-row">
          <span class="ctr-dot ctr-dot--up"></span>
          <span class="ctr-name">bvr-postgres</span>
          <span class="ctr-role">pgvector · port 5432</span>
          <span class="ctr-state">running</span>
        </li>
        <li class="ctr-row">
          <span class="ctr-dot ctr-dot--up"></span>
          <span class="ctr-name">bvr-redis</span>
          <span class="ctr-role">Event bus · port 6379</span>
          <span class="ctr-state">running</span>
        </li>
        <li class="ctr-row">
          <span class="ctr-dot ctr-dot--up"></span>
          <span class="ctr-name">bvr-workers</span>
          <span class="ctr-role">AI Agents workforce</span>
          <span class="ctr-state">healthy</span>
        </li>
      </ul>
    </div>

    <!-- AI Agents Panel -->
    <div class="agents-panel">
      <h3 class="panel-title">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 2a7 7 0 0 1 7 7v3l1.5 3H3.5L5 12V9a7 7 0 0 1 7-7z"/><path d="M9 21h6"/><path d="M12 17v4"/></svg>
        Autonomous AI Agents
        <span class="panel-badge panel-badge--green" data-live="agents-count-badge">3 active</span>
      </h3>
      <ul class="agents-list" data-live="agents-list">
        <li class="agent-row">
          <span class="agent-dot agent-dot--active"></span>
          <div class="agent-info">
            <span class="agent-name">Code Analyzer</span>
            <span class="agent-cap">Repository review &amp; code scanning</span>
          </div>
          <span class="agent-state">active</span>
        </li>
        <li class="agent-row">
          <span class="agent-dot agent-dot--active"></span>
          <div class="agent-info">
            <span class="agent-name">Resume Optimizer</span>
            <span class="agent-cap">ATS optimization &amp; career tools</span>
          </div>
          <span class="agent-state">active</span>
        </li>
        <li class="agent-row">
          <span class="agent-dot agent-dot--active"></span>
          <div class="agent-info">
            <span class="agent-name">Topic Synthesizer</span>
            <span class="agent-cap">Research &amp; knowledge synthesis</span>
          </div>
          <span class="agent-state">active</span>
        </li>
      </ul>
      <div class="event-bus-row">
        <span class="ctr-dot ctr-dot--up"></span>
        <span class="eb-label">Redis Streams Event Bus</span>
        <span class="eb-val" data-live="events-logged">0 events logged</span>
      </div>
    </div>

  </div>

  <p class="live-note" data-live="note">
    Showing static baseline. Live silicon metrics load from homelab every 30 seconds.
  </p>
</section>
<script is:inline src="/js/live.js" defer></script>

<style>
  /* ── Section shell ───────────────────────────────────────────── */
  .live {
    max-width: 52rem;
    margin: 0 0 clamp(2rem, 5vw, 3.5rem);
    padding: clamp(0.9rem, 2.5vw, 1.25rem);
    background: var(--panel);
    border: 1px solid var(--rule);
    border-radius: 10px;
    box-shadow: var(--glow);
  }
  .live-head { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; flex-wrap: wrap; margin-bottom: 1rem; }
  .live-head h2 { font-size: clamp(1.1rem, 1rem + 0.5vw, 1.35rem); font-stretch: 90%; margin: 0; }
  .live-tagline { color: var(--muted); font-size: 0.82rem; margin: 0.2rem 0 0; }
  .live-links { display: flex; align-items: center; gap: 0.8rem; flex-wrap: wrap; }
  .live-src { font-size: 0.82rem; font-weight: 650; }
  .live-badge { display: inline-flex; align-items: center; gap: 0.4rem; font-size: 0.82rem; font-weight: 650; }
  .badge-dot { width: 0.6rem; height: 0.6rem; border-radius: 50%; background: var(--led-off); flex: none; }
  .badge-dot[data-state="up"] { background: var(--led-live); animation: pulse 2.4s ease-in-out infinite; }
  .badge-dot[data-state="down"] { background: #e5484d; }

  /* ── Gauges row ──────────────────────────────────────────────── */
  .gauges-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 9.5rem), 1fr));
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }
  .gauge-card {
    padding: 0.85rem 0.9rem;
    background: var(--aisle);
    border: 1px solid var(--rule);
    border-radius: 8px;
    display: flex; flex-direction: column; align-items: center; gap: 0.4rem;
    text-align: center;
  }
  .gauge-name { margin: 0; font-size: 0.8rem; font-weight: 650; color: var(--text); }
  .gauge-hint { color: var(--muted); font-size: 0.75rem; font-weight: 400; }

  /* Ring gauges */
  .ring-wrap { position: relative; display: flex; align-items: center; justify-content: center; }
  .ring { transform: rotate(-90deg); overflow: visible; }
  .ring-bg { fill: none; stroke: var(--rule); stroke-width: 10; }
  .ring-fill { fill: none; stroke-width: 10; stroke-linecap: round; transition: stroke-dashoffset 0.8s ease; }
  .ring-cpu { stroke: #2dd4bf; }
  .ring-ram { stroke: #818cf8; }
  .ring-label {
    position: absolute; inset: 0;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
  }
  .ring-val { font-size: 1.3rem; font-weight: 800; letter-spacing: -0.02em; line-height: 1; }
  .ring-unit { font-size: 0.65rem; font-weight: 650; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }

  /* Sparkbar (mini histogram behind CPU) */
  .sparkbar-wrap { width: 100%; height: 1.2rem; }
  .sparkbar { display: flex; align-items: flex-end; gap: 2px; height: 100%; }
  .sparkbar-wrap .spark-col { flex: 1; border-radius: 2px 2px 0 0; background: rgba(45, 212, 191, 0.5); min-height: 2px; transition: height 0.4s ease; }

  /* Bar rows (RAM, speed) */
  .bar-row { display: flex; align-items: center; gap: 0.4rem; width: 100%; }
  .bar-track { flex: 1; height: 5px; background: var(--rule); border-radius: 9999px; overflow: hidden; }
  .bar-fill { height: 100%; border-radius: 9999px; transition: width 0.8s ease; }
  .bar-green { background: #34d399; }
  .bar-teal  { background: #2dd4bf; }
  .bar-label { font-size: 0.72rem; font-weight: 650; color: var(--muted); white-space: nowrap; }
  .bar-label--good { color: #34d399; }

  /* Uptime card */
  .gauge-card--uptime .uptime-icon { color: #fbbf24; }
  .uptime-data { display: flex; align-items: baseline; gap: 0.3rem; }
  .uptime-val { font-size: 1.6rem; font-weight: 800; letter-spacing: -0.03em; }
  .uptime-unit { font-size: 0.72rem; font-weight: 650; color: var(--muted); }

  /* Speed card */
  .gauge-card--speed .speed-wrap { display: flex; align-items: baseline; gap: 0.25rem; }
  .speed-val { font-size: 1.8rem; font-weight: 800; letter-spacing: -0.04em; color: #2dd4bf; }
  .speed-unit { font-size: 0.75rem; color: var(--muted); font-weight: 650; }

  /* ── Bottom row ──────────────────────────────────────────────── */
  .bottom-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }
  @media (max-width: 38rem) { .bottom-row { grid-template-columns: 1fr; } }

  .container-panel, .agents-panel {
    padding: 0.85rem 0.9rem;
    background: var(--aisle);
    border: 1px solid var(--rule);
    border-radius: 8px;
  }
  .panel-title {
    display: flex; align-items: center; gap: 0.4rem;
    font-size: 0.82rem; font-weight: 700; margin: 0 0 0.6rem;
    color: var(--text);
  }
  .panel-badge {
    margin-left: auto;
    padding: 0.1rem 0.5rem;
    background: var(--panel);
    border: 1px solid var(--rule);
    border-radius: 9999px;
    font-size: 0.72rem; font-weight: 600; color: var(--muted);
  }
  .panel-badge--green { color: #34d399; border-color: rgba(52,211,153,0.3); }

  /* Container list */
  .container-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.3rem; }
  .ctr-row { display: flex; align-items: center; gap: 0.45rem; font-size: 0.8rem; }
  .ctr-dot { flex: none; width: 0.55rem; height: 0.55rem; border-radius: 50%; background: var(--led-off); }
  .ctr-dot--up { background: var(--led-live); }
  .ctr-dot--warn { background: #fbbf24; }
  .ctr-dot--down { background: #e5484d; }
  .ctr-name { font-weight: 650; min-width: 6rem; }
  .ctr-role { color: var(--muted); font-size: 0.72rem; flex: 1; }
  .ctr-state { font-size: 0.72rem; font-weight: 650; color: #34d399; }

  /* Agents list */
  .agents-list { list-style: none; margin: 0 0 0.5rem; padding: 0; display: flex; flex-direction: column; gap: 0.35rem; }
  .agent-row { display: flex; align-items: center; gap: 0.45rem; font-size: 0.8rem; }
  .agent-dot { flex: none; width: 0.55rem; height: 0.55rem; border-radius: 50%; }
  .agent-dot--active { background: var(--led-live); animation: pulse 2.4s ease-in-out infinite; }
  .agent-dot--idle { background: #fbbf24; }
  .agent-dot--offline { background: #e5484d; }
  .agent-info { flex: 1; display: flex; flex-direction: column; }
  .agent-name { font-weight: 650; line-height: 1.2; }
  .agent-cap { color: var(--muted); font-size: 0.7rem; }
  .agent-state { font-size: 0.72rem; font-weight: 650; color: #34d399; }

  .event-bus-row { display: flex; align-items: center; gap: 0.4rem; font-size: 0.75rem; color: var(--muted); border-top: 1px solid var(--rule); padding-top: 0.4rem; margin-top: 0.1rem; }
  .eb-label { flex: 1; }
  .eb-val { font-weight: 650; color: var(--text); }

  /* ── Status pulse ────────────────────────────────────────────── */
  @keyframes pulse { 50% { box-shadow: 0 0 0 5px rgb(47 191 113 / 0.08); } }

  .live-note { margin: 0.75rem 0 0; color: var(--muted); font-size: 0.8rem; }

  @media (forced-colors: active) {
    .live, .gauge-card, .container-panel, .agents-panel { border-color: CanvasText; }
    .ctr-dot, .agent-dot, .badge-dot { forced-color-adjust: none; }
  }
</style>
