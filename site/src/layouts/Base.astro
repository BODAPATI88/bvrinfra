---
import archivoLatin from "@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url";
import archivoLatinExt from "@fontsource-variable/archivo/files/archivo-latin-ext-wdth-normal.woff2?url";
import archivoVietnamese from "@fontsource-variable/archivo/files/archivo-vietnamese-wdth-normal.woff2?url";

// Same faces and unicode ranges as @fontsource-variable/archivo/wdth.css, but with
// font-display: optional instead of swap. The Latin file is preloaded, so it is
// almost always ready for first paint; if it isn't, that page view keeps the
// fallback font instead of re-flowing the headline when Archivo arrives (#30).
const archivoFace = (src: string, range: string) => `@font-face {
  font-family: 'Archivo Variable';
  font-style: normal;
  font-display: optional;
  font-weight: 100 900;
  font-stretch: 62% 125%;
  src: url(${src}) format('woff2-variations');
  unicode-range: ${range};
}`;
const fontFaces = [
  archivoFace(archivoVietnamese, "U+0102-0103,U+0110-0111,U+0128-0129,U+0168-0169,U+01A0-01A1,U+01AF-01B0,U+0300-0301,U+0303-0304,U+0308-0309,U+0323,U+0329,U+1EA0-1EF9,U+20AB"),
  archivoFace(archivoLatinExt, "U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF"),
  archivoFace(archivoLatin, "U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD"),
].join("\n");
import ThemeSwitch from "../components/ThemeSwitch.astro";
import { phoneTel, whatsapp, mail, hello, icons } from "../data/contact";

interface Props {
  title: string;
  description: string;
  type?: "website" | "article";
  jsonLd?: Record<string, unknown>;
}
const { title, description, type = "website", jsonLd } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const ogImage = new URL("/og.png", Astro.site).toString();
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
// Phone contact bar: on every page except Contact, which already is one.
const showDock = !path.startsWith("/contact");
const dock = [
  { label: "WhatsApp", icon: icons.chat, href: whatsapp(hello), primary: true },
  { label: "Call", icon: icons.phone, href: `tel:${phoneTel}` },
  { label: "Email", icon: icons.email, href: mail("Enquiry from bvrinfra.in") },
];
const nav = [
  { href: "/skills", label: "Skills" },
  { href: "/projects", label: "Projects" },
  { href: "/log", label: "Log" },
  { href: "/contact", label: "Contact" },
  { href: "https://status.bvrinfra.in", label: "Status" },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <!-- Preload the Latin font subset so the big headline doesn't reflow when it arrives. -->
    <link rel="preload" href={archivoLatin} as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={fontFaces}></style>
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Link previews (WhatsApp, LinkedIn, Slack, search) -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="bvrinfra.in" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="I build infrastructure that can be rebuilt. Ravi Kishore, bvrinfra.in" />
    <meta property="og:locale" content="en_IN" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#e9eef2" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0f14" media="(prefers-color-scheme: dark)" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />

    <!-- Blocking on purpose: applies a saved theme before first paint, so it never flashes. -->
    <script is:inline src="/js/theme-init.js"></script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="masthead">
      <a class="wordmark" href="/" aria-current={path === "/" ? "page" : undefined}>bvrinfra.in</a>
      <nav aria-label="Main">
        {nav.map((item) => (
          <a href={item.href} aria-current={path === item.href || path.startsWith(item.href + "/") ? "page" : undefined}>{item.label}</a>
        ))}
      </nav>
      <ThemeSwitch />
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="foot">
      <p>© 2026 Ravi Kishore</p>
      <p><a href="https://github.com/BODAPATI88/bvrinfra">Source for this site</a></p>
    </footer>
    {showDock && (
      <nav class="dock" aria-label="Contact Ravi">
        {dock.map((d) => (
          <a href={d.href} class:list={[d.primary && "dock-primary"]} rel={d.href.startsWith("http") ? "noopener" : undefined}>
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" set:html={d.icon} />
            <span>{d.label}</span>
          </a>
        ))}
      </nav>
    )}
  </body>
</html>

<style is:global>
  /* Light tokens are the default; dark applies when the system asks for it
     (and the visitor hasn't picked light), or when the visitor picks dark. */
  :root {
    --aisle: #e9eef2;
    --panel: #f7f9fb;
    --ink: #111a22;
    --muted: #46535f;
    --rule: #c3cdd6;
    --cable: #0f766e;
    --glow: 0 1px 2px rgb(17 26 34 / 0.06), 0 10px 24px -16px rgb(15 118 110 / 0.35);
    --steel: #1e262e;
    --steel-2: #29323b;
    --steel-3: #343e48;
    --steel-line: #4a5561;
    --steel-ink: #e6ebf0;
    --steel-muted: #a3afba;
    --led-live: #2fbf71;
    --led-build: #f0b429;
    --led-off: #66717c;
    --font: "Archivo Variable", "Helvetica Neue", Arial, sans-serif;
    --gutter: max(1rem, env(safe-area-inset-left), env(safe-area-inset-right));
    --page: min(100% - 2 * var(--gutter), 90rem);
    color-scheme: light;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --aisle: #0a0f14;
      --panel: #111922;
      --ink: #e6edf3;
      --muted: #9aa8b5;
      --rule: #22303c;
      --cable: #2dd4bf;
      --glow: 0 0 0 1px rgb(45 212 191 / 0.06), 0 12px 32px -18px rgb(45 212 191 / 0.45);
      --steel: #070b0f;
      --steel-2: #10171e;
      --steel-3: #18212a;
      --steel-line: #2a3744;
      color-scheme: dark;
    }
  }
  :root[data-theme="dark"] {
    --aisle: #0a0f14;
    --panel: #111922;
    --ink: #e6edf3;
    --muted: #9aa8b5;
    --rule: #22303c;
    --cable: #2dd4bf;
    --glow: 0 0 0 1px rgb(45 212 191 / 0.06), 0 12px 32px -18px rgb(45 212 191 / 0.45);
    --steel: #070b0f;
    --steel-2: #10171e;
    --steel-3: #18212a;
    --steel-line: #2a3744;
    color-scheme: dark;
  }

  /* Visitors who ask the system for more contrast get it. */
  @media (prefers-contrast: more) {
    :root { --muted: var(--ink); --rule: var(--ink); --steel-muted: var(--steel-ink); }
  }

  *, *::before, *::after { box-sizing: border-box; }
  html {
    font-size: clamp(100%, 0.94rem + 0.25vw, 118.75%);
    -webkit-text-size-adjust: 100%;
    text-size-adjust: 100%;
    scroll-behavior: smooth;
  }
  body {
    margin: 0;
    min-height: 100dvh;
    background: var(--aisle);
    color: var(--ink);
    font-family: var(--font);
    line-height: 1.55;
    -webkit-font-smoothing: antialiased;
    -webkit-tap-highlight-color: transparent;
  }
  a {
    color: var(--cable); text-underline-offset: 0.18em; text-decoration-thickness: 1px;
    transition: text-decoration-thickness 0.2s ease, text-underline-offset 0.2s ease, color 0.2s ease;
  }
  a:hover { text-decoration-thickness: 2px; text-underline-offset: 0.25em; }
  :focus-visible { outline: 3px solid var(--cable); outline-offset: 3px; border-radius: 2px; }
  h1, h2, h3 { line-height: 1.05; margin: 0; font-weight: 700; }
  p { margin: 0 0 1em; }

  .skip {
    position: absolute; left: -9999px; top: 0;
    background: var(--ink); color: var(--aisle); padding: 0.75rem 1rem;
  }
  .skip:focus { left: var(--gutter); top: max(1rem, env(safe-area-inset-top)); z-index: 10; }

  .masthead, main, .foot { width: var(--page); margin-inline: auto; }

  .masthead {
    display: flex; align-items: center; flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    padding-top: max(1rem, env(safe-area-inset-top));
  }
  .wordmark {
    color: var(--ink); text-decoration: none;
    font-weight: 800; font-size: 1.1rem;
    font-stretch: 75%;
    margin-right: auto;
    padding-block: 0.6rem;
  }
  .masthead nav { display: flex; gap: 0.25rem 1.25rem; flex-wrap: wrap; }

  /* Phones: row 1 is the wordmark and the theme button, row 2 is the nav on one line. */
  @media (max-width: 30rem) {
    .masthead { gap: 0 0.75rem; }
    .masthead nav { order: 3; flex-basis: 100%; justify-content: space-between; gap: 0 0.5rem; flex-wrap: nowrap; }
    .masthead nav a { font-size: 0.95rem; }
  }
  .masthead nav a {
    color: var(--muted); text-decoration: none;
    display: inline-flex; align-items: center; min-height: 44px;
    transition: color 0.2s ease-in-out;
  }
  .masthead nav a:hover, .masthead nav a[aria-current="page"] { color: var(--ink); }
  .masthead nav a[aria-current="page"] { text-decoration: underline; text-decoration-thickness: 2px; }

  main { padding-block: clamp(2rem, 6vw, 4.5rem) clamp(3rem, 8vw, 5rem); }

  .foot {
    border-top: 1px solid var(--rule);
    padding-block: 1.25rem max(2rem, env(safe-area-inset-bottom));
    display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap;
    color: var(--muted); font-size: 0.9rem;
  }
  .foot p { margin: 0; }

  .page-title {
    font-size: clamp(2.4rem, 6vw, 4rem);
    font-stretch: 112%;
    letter-spacing: -0.02em;
    margin-bottom: 1.25rem;
  }
  .lede { font-size: 1.15rem; color: var(--muted); max-width: 38em; }
  .prose { max-width: 38em; }

  /* Windows High Contrast and other forced-colour modes: let the system palette win,
     but keep the rack's structure visible. */
  @media (forced-colors: active) {
    .masthead nav a[aria-current="page"] { text-decoration: underline; }
  }

  /* Phone contact bar: fixed to the bottom on small screens only. */
  .dock { display: none; }
  @media (max-width: 40rem) {
    .dock {
      position: fixed; inset: auto 0 0 0; z-index: 20;
      display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.4rem;
      padding: 0.45rem max(0.6rem, env(safe-area-inset-left)) max(0.45rem, env(safe-area-inset-bottom)) max(0.6rem, env(safe-area-inset-right));
      background: color-mix(in srgb, var(--aisle) 88%, transparent);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      border-top: 1px solid var(--rule);
    }
    .dock a {
      display: flex; align-items: center; justify-content: center; gap: 0.4rem;
      min-height: 2.75rem; border-radius: 8px;
      border: 1px solid var(--cable); color: var(--cable);
      font-weight: 700; font-size: 0.92rem; text-decoration: none;
    }
    .dock a.dock-primary { background: var(--cable); color: var(--aisle); }
    .dock svg { fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
    body:has(.dock) .foot { padding-bottom: calc(5rem + env(safe-area-inset-bottom)); }
  }
  @media print { .dock { display: none !important; } }
  @media (forced-colors: active) {
    .dock { border-top-color: CanvasText; }
    .dock a { border-color: CanvasText; }
  }

  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    *, *::before, *::after { animation: none !important; transition: none !important; }
  }
</style>
