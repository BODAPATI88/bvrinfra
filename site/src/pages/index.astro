---
import Base from "../layouts/Base.astro";
import Rack from "../components/Rack.astro";
---
<Base
  jsonLd={{
    "@context": "https://schema.org",
    "@type": "Person",
    name: "Ravi Kishore",
    jobTitle: "Infrastructure engineer",
    url: "https://bvrinfra.in/",
    address: { "@type": "PostalAddress", addressLocality: "Hyderabad", addressCountry: "IN" },
    knowsAbout: ["Windows Server", "Active Directory", "VMware vSphere", "Microsoft Azure", "Terraform", "Data-centre operations"],
    hasCredential: {
      "@type": "EducationalOccupationalCredential",
      name: "Microsoft Certified: Windows Server Administrator Associate",
      credentialCategory: "certification",
      url: "https://learn.microsoft.com/api/credentials/share/en-gb/ravikishorebodapati-6050/D47F6B39F21E097C?sharingId=E66A053EF999F415",
    },
    sameAs: ["https://github.com/BODAPATI88", "https://www.linkedin.com/in/ravikishore-b-917b85226/"],
  }}
  title="Ravi Kishore, infrastructure engineer"
  description="Infrastructure engineer in Hyderabad. Windows Server, Active Directory, VMware, hybrid Azure, and automation. This site is built and run as infrastructure as code."
>
  <section class="hero" aria-labelledby="headline">
    <div class="id-row">
      <picture>
        <source type="image/webp" srcset="/img/ravi-192.webp 1x, /img/ravi-384.webp 2x" />
        <img class="photo" src="/img/ravi-192.jpg" srcset="/img/ravi-192.jpg 1x, /img/ravi-384.jpg 2x"
          width="192" height="192" alt="Ravi Kishore" fetchpriority="high" decoding="async" />
      </picture>
      <div class="id-text">
        <p class="who">Ravi Kishore · Hyderabad, India</p>
        <h1 id="headline" class="headline">Infrastructure engineer</h1>
        <p class="stack-line">Windows Server · VMware · hybrid Azure</p>
      </div>
    </div>

    <p class="lede-home">
      Infrastructure operations across eight data centre sites in the US and Japan: provisioning VMs,
      qualifying releases and handling incidents. Next: platform engineering and SRE.
    </p>

    <dl class="stats" aria-label="At a glance">
      <div class="stat"><dt>Years in infrastructure</dt><dd class="num">9.5</dd></div>
      <div class="stat"><dt>Data centre sites, US and Japan</dt><dd class="num">8</dd></div>
      <div class="stat"><dt>Engineers in my on-call rotation</dt><dd class="num">5</dd></div>
    </dl>

    <a class="cert" href="https://learn.microsoft.com/api/credentials/share/en-gb/ravikishorebodapati-6050/D47F6B39F21E097C?sharingId=E66A053EF999F415" rel="noopener">
      <svg class="cert-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.8 4.5 5.6v5.8c0 4.6 3.1 8.6 7.5 9.8 4.4-1.2 7.5-5.2 7.5-9.8V5.6z"/><path d="m8.5 12 2.5 2.5 4.6-5"/></svg>
      <span class="cert-text">
        <span class="cert-kind">Microsoft Certified</span>
        <span class="cert-name">Windows Server Administrator Associate</span>
        <span class="cert-meta">AZ-800 · AZ-801 · Verify on Microsoft Learn</span>
      </span>
    </a>

    <ul class="chips" aria-label="Core skills">
      <li>Windows Server</li>
      <li>Active Directory</li>
      <li>VMware vSphere</li>
      <li>Hybrid Azure</li>
      <li>Terraform</li>
    </ul>

    <p class="actions">
      <a class="btn btn-primary" href="/contact/">Contact</a>
      <a class="btn" href="mailto:hello@bvrinfra.in?subject=CV%20request%20from%20bvrinfra.in">Request CV</a>
      <a class="btn" href="https://www.linkedin.com/in/ravikishore-b-917b85226/" rel="noopener">LinkedIn</a>
      <a class="btn btn-quiet" href="/skills/">All skills</a>
    </p>

    <section class="career" aria-labelledby="career">
      <h2 id="career">Career</h2>
      <ol class="timeline">
        <li><span class="t-years">2025 – now</span><span class="t-role">System Administrator III</span><span class="t-what">Data centre operations across 8 sites in the US and Japan</span></li>
        <li><span class="t-years">2023 – 2025</span><span class="t-role">Senior Systems Engineer</span><span class="t-what">Windows Server, Active Directory, VMware and hybrid identity (Entra ID)</span></li>
        <li><span class="t-years">2020 – 2023</span><span class="t-role">Systems Engineer</span><span class="t-what">Windows Server, Active Directory and virtualization at enterprise client sites</span></li>
        <li><span class="t-years">2013 – 2017</span><span class="t-role">Systems / IT Support Engineer</span><span class="t-what">Windows Server, Active Directory and infrastructure support</span></li>
      </ol>
      <p class="t-note">Full history with employers on request.</p>
    </section>

    <Rack />
  </section>

  <section class="story" aria-labelledby="why">
    <h2 id="why">How this site runs</h2>
    <div class="prose">
      <p>
        Built and run as infrastructure as code: one repository, every change through a pull request,
        DNS in Terraform and monitoring from outside. Open any unit in the rack to see how it works.
        The decisions are written up in <a href="https://github.com/BODAPATI88/bvrinfra/blob/main/docs/adr/0001-bvrinfra-architecture.md">ADR 0001</a>.
      </p>
    </div>
  </section>

  <section class="next-reads" aria-labelledby="read-next">
    <h2 id="read-next">Read next</h2>
    <ul>
      <li>
        <a href="/skills/">
          <span class="nr-kind">Skills</span>
          <span class="nr-title">What I know, and how deep it goes</span>
          <span class="nr-desc">About 9.5 years, from Windows and VMware to data-centre operations.</span>
        </a>
      </li>
      <li>
        <a href="/log/">
          <span class="nr-kind">Build log</span>
          <span class="nr-title">Done, next and later</span>
          <span class="nr-desc">Every step of the rebuild with dates, and what comes after backups.</span>
        </a>
      </li>
      <li>
        <a href="/writing/september-2026-outage/">
          <span class="nr-kind">Post-mortem</span>
          <span class="nr-title">The September 2026 outage</span>
          <span class="nr-desc">What failed, why nothing could be restored, and what changed.</span>
        </a>
      </li>
    </ul>
  </section>
</Base>

<style>
  .who {
    color: var(--muted); font-stretch: 85%;
    margin-bottom: 0.9rem;
  }
  .headline {
    /* Sized to the viewport so the longest word, "infrastructure", always fits on one line. */
    font-size: clamp(2.2rem, 7vw, 4.75rem);
    font-stretch: 125%;
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 0.95;
    margin-bottom: clamp(1.5rem, 4vw, 2.75rem);
    max-width: 14ch;
    text-wrap: balance;
    overflow-wrap: break-word;
    hyphens: manual;
  }
  .id-row {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 3vw, 2rem);
    margin-bottom: 1.25rem;
  }
  .id-text { min-width: 0; }
  .id-text .stack-line { margin-bottom: 0; }
  .id-text .headline { margin-bottom: 0.75rem; }
  .photo {
    display: block;
    width: clamp(5.5rem, 18vw, 9rem);
    height: auto;
    aspect-ratio: 1;
    border-radius: 50%;
    border: 3px solid var(--cable);
    box-shadow: var(--glow);
    object-fit: cover;
  }
  @media (max-width: 30rem) {
    .id-row { flex-direction: column; align-items: flex-start; gap: 0.9rem; }
  }

  .career { margin: 0 0 clamp(2rem, 5vw, 3.5rem); max-width: 52rem; }
  .career h2 { font-size: clamp(1.2rem, 1.05rem + 0.6vw, 1.5rem); font-stretch: 90%; margin-bottom: 0.9rem; }
  .timeline { list-style: none; margin: 0; padding: 0 0 0 1.25rem; border-left: 2px solid var(--rule); }
  .timeline li {
    position: relative;
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    column-gap: 1rem;
    padding: 0 0 1rem;
  }
  .timeline li::before {
    content: "";
    position: absolute; left: calc(-1.25rem - 7px); top: 0.35rem;
    width: 12px; height: 12px; border-radius: 50%;
    background: var(--aisle); border: 2px solid var(--cable);
  }
  .timeline li:first-child::before { background: var(--cable); }
  .t-years { color: var(--muted); font-size: 0.9rem; font-stretch: 88%; grid-row: span 2; padding-top: 0.1rem; }
  .t-role { font-weight: 750; font-stretch: 94%; }
  .t-what { color: var(--muted); font-size: 0.95rem; }
  .t-note { color: var(--muted); font-size: 0.9rem; margin: 0; }
  @media (max-width: 30rem) {
    .timeline li { grid-template-columns: 1fr; }
    .t-years { grid-row: auto; }
  }
  @media (forced-colors: active) {
    .photo { border-color: CanvasText; }
    .timeline li::before { border-color: CanvasText; background: Canvas; forced-color-adjust: none; }
    .timeline li:first-child::before { background: CanvasText; }
  }

  .stack-line {
    font-size: clamp(1.15rem, 1rem + 0.8vw, 1.6rem);
    font-weight: 650;
    font-stretch: 90%;
    color: var(--cable);
    margin: -0.5rem 0 1.25rem;
  }
  .lede-home {
    font-size: clamp(1.05rem, 1rem + 0.3vw, 1.25rem);
    line-height: 1.5;
    max-width: 40em;
    margin-bottom: 1.75rem;
  }

  /* At a glance: the numbers a recruiter looks for, readable in seconds. */
  .stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(0.5rem, 1.5vw, 0.75rem);
    margin: 0 0 1rem;
    max-width: 52rem;
  }
  .stat {
    box-shadow: var(--glow);
    background: var(--panel);
    border: 1px solid var(--rule);
    border-left: 4px solid var(--cable);
    border-radius: 8px;
    padding: clamp(0.6rem, 2vw, 0.85rem) clamp(0.6rem, 2vw, 1rem);
    display: flex; flex-direction: column-reverse; justify-content: flex-end; gap: 0.2rem;
  }
  .stat dt { color: var(--muted); font-size: clamp(0.78rem, 0.72rem + 0.3vw, 0.9rem); font-stretch: 85%; line-height: 1.25; }
  .stat dd { margin: 0; }
  .num {
    font-size: clamp(1.8rem, 1.4rem + 1.8vw, 2.6rem);
    font-weight: 800;
    font-stretch: 110%;
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .cert {
    box-shadow: var(--glow);
    display: inline-flex; align-items: center; gap: 0.85rem;
    max-width: 52rem;
    margin: 0 0 1rem;
    padding: 0.8rem 1.1rem 0.8rem 0.9rem;
    background: var(--panel);
    border: 1px solid var(--rule);
    border-radius: 8px;
    color: var(--ink);
    text-decoration: none;
  }
  .cert:hover { border-color: var(--cable); }
  .cert:hover .cert-meta { text-decoration: underline; text-decoration-thickness: 2px; }
  .cert-icon {
    flex: none; width: 2.4rem; height: 2.4rem;
    fill: none; stroke: var(--led-live); stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round;
  }
  .cert-text { display: flex; flex-direction: column; gap: 0.1rem; }
  .cert-kind { font-size: 0.85rem; color: var(--muted); font-stretch: 85%; }
  .cert-name { font-weight: 750; font-stretch: 92%; line-height: 1.2; }
  .cert-meta { font-size: 0.9rem; color: var(--cable); }

  .chips {
    list-style: none; margin: 0 0 1.5rem; padding: 0;
    display: flex; flex-wrap: wrap; gap: 0.5rem;
    max-width: 52rem;
  }
  .chips li {
    padding: 0.3rem 0.75rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: var(--panel);
    font-size: 0.95rem;
    font-weight: 600;
    font-stretch: 92%;
  }

  .actions { display: flex; flex-wrap: wrap; gap: 0.6rem; margin: 0 0 clamp(2rem, 5vw, 3.5rem); }
  .btn {
    display: inline-flex; align-items: center; min-height: 2.75rem;
    padding: 0.5rem 1.2rem;
    border: 1px solid var(--cable);
    border-radius: 8px;
    color: var(--cable);
    font-weight: 700;
    text-decoration: none;
  }
  .btn:hover { text-decoration: underline; text-decoration-thickness: 2px; }
  .btn-primary { background: var(--cable); color: var(--aisle); }
  .btn-quiet { border-color: var(--rule); color: var(--ink); }

  @media (forced-colors: active) {
    .stat, .cert, .chips li, .btn { border-color: CanvasText; }
    .stat { border-left-width: 4px; }
    .cert-icon { stroke: CanvasText; }
    .btn-primary { background: ButtonText; color: ButtonFace; forced-color-adjust: none; }
  }

  .story {
    margin-top: clamp(3.5rem, 8vw, 6rem);
    padding-top: 2rem;
    border-top: 1px solid var(--rule);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: 2rem;
  }
  .story h2 {
    font-size: clamp(1.35rem, 1.1rem + 0.8vw, 1.8rem);
    font-stretch: 90%;
    max-width: 14ch;
  }

  .next-reads { margin-top: clamp(3rem, 7vw, 5rem); }
  .next-reads h2 { font-size: clamp(1.35rem, 1.1rem + 0.8vw, 1.8rem); font-stretch: 90%; margin-bottom: 1.25rem; }
  .next-reads ul {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr)); gap: 1rem;
  }
  .next-reads a {
    display: flex; flex-direction: column; gap: 0.35rem; height: 100%;
    padding: 1.2rem 1.25rem 1.3rem;
    background: var(--panel); border: 1px solid var(--rule); border-radius: 8px;
    box-shadow: var(--glow);
    color: var(--ink); text-decoration: none;
  }
  .next-reads a:hover { border-color: var(--cable); }
  .next-reads a:hover .nr-title { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 0.2em; }
  .nr-kind { color: var(--muted); font-size: 0.85rem; font-stretch: 85%; }
  .nr-title { font-weight: 750; font-size: 1.2rem; font-stretch: 92%; line-height: 1.2; }
  .nr-desc { color: var(--muted); font-size: 0.95rem; }

  @media (max-width: 52rem) {
    .story { grid-template-columns: 1fr; }
  }
</style>
